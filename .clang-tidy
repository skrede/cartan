readability-function-size,
readability-function-cognitive-complexity,
# Everything from here down is a check with findings in the tree. This list is the whole
# gated set: the linter step promotes every check still enabled above to an error and
# carries no check list of its own. Each entry says why it is off. Turning one back on
# means clearing its findings first.,
# the twenty-five-line function ceiling is enforced by nothing. EXCEPTIONS.md carries the
# count and the condition under which these two move into the gated set.,
-readability-function-size,
-readability-function-cognitive-complexity,
# argues for auto in locals whose type this codebase spells out deliberately.,
-modernize-use-auto,
# real copies on the solver paths. An optimization to measure rather than a mechanical
# rewrite performed to clear a gate.,
-performance-unnecessary-copy-initialization,
# two shapes. Seven sites are the expected shim whose union storage is initialized through
# its discriminator rather than through an init list. The other four are analytical result
# aggregates whose contract is that only the first count entries of the solution array are
# populated -- zeroing the rest is work spent producing values no caller may read.,
-cppcoreguidelines-pro-type-member-init,
# the two-line nested namespace spelling is uniform across the detail headers. Adopting the
# concatenated form is a rename touching all of them at once.,
-modernize-concat-nested-namespaces,
# search loops written out. An algorithm call would read better and neither is a defect.,
-readability-use-anyofallof,
-modernize-loop-convert,
# a count asserted as a count in a test. The empty form asserts something narrower.,
-readability-container-size-empty,
# a test helper naming its return type where a braced list would elide it.,
-modernize-return-braced-init-list,
# a fixture whose copy operations are written out alongside move operations that cannot be
# defaulted -- they null the source -- so the five read as one unit.,
-modernize-use-equals-default,
# a widening cast over an int expression bounded to zero through three. Ineffective as the
# check says and harmless because the bound rules out the overflow it guards against.,
-bugprone-misplaced-widening-cast,
# an Eigen fixed-size vector taken by value in a test helper. Not a library finding.,
-performance-unnecessary-value-param'
CheckOptions:
  - { key: readability-function-size.LineThreshold,                value: 25 }
  - { key: readability-function-size.StatementThreshold,           value: -1 }
  - { key: readability-function-size.BranchThreshold,              value: -1 }
  - { key: readability-function-size.NestingThreshold,             value: -1 }
  - { key: readability-function-cognitive-complexity.Threshold,    value: 25 }
  - { key: readability-function-cognitive-complexity.IgnoreMacros, value: true }