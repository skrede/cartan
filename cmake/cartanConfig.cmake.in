@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Eigen3)
if (Eigen3_VERSION VERSION_LESS "3.4")
    message(FATAL_ERROR "cartan requires Eigen >= 3.4, found ${Eigen3_VERSION}")
endif ()

# No version constraint: cartan tracks the description reader by revision, and
# a constraint here would be a second, independently drifting claim about which
# revisions work. The reader's own config package resolves the XML library it
# links, so cartan neither names nor pins it.
set(CARTAN_WITH_URDF @CARTAN_BUILD_URDF@)
if (CARTAN_WITH_URDF)
    find_dependency(meios)
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/cartanTargets.cmake")

check_required_components(cartan)
