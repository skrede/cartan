<?xml version="1.0"?>
<!-- A robot that clears every gate but one: well-formed XML, a single serial
     chain of two links, a finite ordered limit, a unit axis. The only thing
     wrong with it is that the include below names a file that does not exist,
     so a load that accepts it accepted a truncated robot. -->
<robot name="xacro_unresolved_include" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="no_such_file_anywhere.xacro"/>

  <link name="base_link"/>
  <link name="tool"/>

  <joint name="shoulder" type="revolute">
    <parent link="base_link"/>
    <child link="tool"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" velocity="2.0" effort="50.0"/>
  </joint>

</robot>
