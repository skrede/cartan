<?xml version="1.0"?>
<robot name="all_fixed_linear">

  <link name="base_link"/>
  <link name="mount"/>
  <link name="tool"/>

  <joint name="base_to_mount" type="fixed">
    <parent link="base_link"/>
    <child link="mount"/>
    <origin xyz="0.1 0.2 0.3" rpy="0 0 1.5707963267948966"/>
  </joint>

  <joint name="mount_to_tool" type="fixed">
    <parent link="mount"/>
    <child link="tool"/>
    <origin xyz="0.05 0 0.4" rpy="0 0 0"/>
  </joint>

</robot>
