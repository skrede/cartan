<?xml version="1.0"?>
<robot name="partial_limit_revolute">

  <link name="base_link">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <link name="tool"/>

  <joint name="shoulder" type="revolute">
    <parent link="base_link"/>
    <child link="tool"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit velocity="2.0" effort="50.0"/>
  </joint>

</robot>
