<?xml version="1.0"?>
<!-- Reversed position bounds: the lower limit exceeds the upper one, so the
     joint is feasible nowhere. Rejected by the checked limits factory. -->
<robot name="reversed_limit">

  <link name="base_link"/>
  <link name="tip"/>

  <joint name="reversed_joint" type="revolute">
    <parent link="base_link"/>
    <child link="tip"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="1.0" upper="-1.0" velocity="2.0" effort="50.0"/>
  </joint>

</robot>
