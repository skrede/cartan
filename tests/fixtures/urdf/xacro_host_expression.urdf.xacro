<?xml version="1.0"?>
<!-- Identical to xacro_minimal apart from one origin, which converts its
     property through the host language's float() rather than through
     arithmetic. The built-in evaluator refuses that call; a Python evaluation
     backend would perform it. -->
<robot name="xacro_host_expression" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="segment_length" value="0.2"/>

  <link name="base_link"/>
  <link name="tool"/>

  <joint name="tool_joint" type="revolute">
    <parent link="base_link"/>
    <child link="tool"/>
    <origin xyz="0 0 ${float(segment_length)}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" velocity="2.0" effort="50.0"/>
  </joint>

</robot>
